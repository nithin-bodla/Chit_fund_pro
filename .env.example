# =============================================================
# ChitFund Pro - Environment Configuration
# =============================================================

# 1. Neon PostgreSQL Connection String (from Vercel Marketplace or Neon.tech)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication Secret (32+ character random string for JWT signing)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long-here"

# 3. Initial Administrator Credentials (Set your private admin credentials)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-admin-password"

# 4. Chit Fund Customization
CHIT_FUND_NAME="Sri Lakshmi Chit Fund"
